#include <stdio.h>

int main(void)
{
    int n;
    int f;
    
    // Вводите два числа через пробел или Enter (например: 3 5)
    printf("Enter table size (2..10):\n");
    
    // ИСПРАВЛЕНО: оба %d внутри одной строки формата
    if (scanf("%d %d", &n, &f) != 2)
    {
        printf("input error\n");
        return 1;
    }
    
    // ИСПРАВЛЕНО: проверяем границы 2..10 и связываем через ИЛИ (||)
    // Если ХОТЯ БЫ ОДНО число выходит за рамки — это ошибка
    if (n < 2 || n > 10 || f < 2 || f > 10)
    {
        printf("range error\n");
        return 1;
    }
    
    // Рисуем прямоугольник
    for (int w = 1; w <= n; w++)
    {
        for (int h = 1; h <= f; h++)
        {
            if (w==1 || w==n || h==1 || h==f) 
            {
            printf("%4s", "*");
            }
            else
            {
                printf("%4s", " ");
            }
        }
        printf("\n");
    }
    return 0;
}
